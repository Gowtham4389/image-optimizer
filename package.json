{
  "name": "pixelwell-image-optimizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.md index.html",
    "format:check": "prettier --check src tests *.ts *.json *.md index.html"
  },
  "dependencies": {
    "@bentopdf/gs-wasm": "0.1.1",
    "@jsquash/avif": "2.1.1",
    "cropperjs": "1.6.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
